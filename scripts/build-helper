#!/usr/bin/env bash

set -euo pipefail

source_root=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

mkdir -p "$source_root/build"

compiler=${CC:-cc}
compile_flags=(-std=c11 -O2 -Wall -Wextra -Werror -pedantic)
link_flags=()

if [[ ${AUTOLITH_BUILD_STATIC_NATIVE:-} == 1 ]]; then
  link_flags=(-static -no-pie)
fi

"$compiler" "${compile_flags[@]}" \
  "$source_root/helper/cl-exec-sandbox-process-group.c" \
  "${link_flags[@]}" \
  -o "$source_root/build/cl-exec-sandbox-process-group"

if [[ $(uname -s) == Linux ]]; then
  "$compiler" "${compile_flags[@]}" \
    "$source_root/helper/cl-exec-sandbox-helper.c" \
    "${link_flags[@]}" \
    -o "$source_root/build/cl-exec-sandbox-helper"
fi
